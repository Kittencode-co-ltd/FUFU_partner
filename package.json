{
  "name": "fufu-partner",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --import dotenv/config server/index.js",
    "lint": "node --check server/index.js && node --check server/routes/appointments.js && node --check server/routes/clinic.js && node --check server/routes/visits.js && node --check public/js/partner/appointments-mvp.js",
    "build:css": "tailwindcss -i src/css/input.css -o public/css/main.css --minify",
    "watch:css": "tailwindcss -i src/css/input.css -o public/css/main.css --watch",
    "test": "node --test test/*.test.js",
    "security:secrets": "node scripts/secret-scan.mjs",
    "test:security-integration": "node test/security-integration.mjs",
    "test:p2-integration": "node test/p2-integration.mjs",
    "test:p3-p4-integration": "node test/p3-p4-integration.mjs",
    "test:all": "npm test && npm run security:secrets"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "pg": "^8.20.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13"
  }
}
